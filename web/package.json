{
  "name": "reelucid-web",
  "version": "1.1.4",
  "private": true,
  "packageManager": "npm@11.19.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit && prettier --check src",
    "format": "prettier --write src"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "~8.3.8"
  }
}
