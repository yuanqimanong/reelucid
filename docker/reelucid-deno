#!/usr/bin/env python3
"""Constrain yt-dlp's JS solver to stdin/local code with no network permission."""
import os
import sys

args = sys.argv[1:]
if args == ["--version"]:
    os.execvp("deno", ["deno", "--version"])
if not args or args[0] != "run":
    raise SystemExit("Only deno run and --version are supported")
if any(arg in {"-A", "--allow-all", "--allow-run", "--allow-ffi"} or arg.startswith(("--allow-run=", "--allow-ffi=")) for arg in args):
    raise SystemExit("Unsafe Deno capability requested")
args = [arg for arg in args if not arg.startswith("--allow-net")]
os.execvp("deno", ["deno", "run", "--deny-net", "--deny-run", "--deny-ffi", "--no-prompt", *args[1:]])
