REELUCID_IMAGE=yuanqimanong/reelucid:1.1.5
# Host directory for artifacts. Leave empty to store them in the data volume.
REELUCID_ARTIFACTS_DIR=
# Settings used by scripts/deploy.sh.
REELUCID_CONTAINER_NAME=reelucid
REELUCID_DATA_VOLUME=reelucid-data
REELUCID_LISTEN=127.0.0.1:8000
REELUCID_CPU_LIMIT=4.0
REELUCID_MEMORY_LIMIT=6g
REELUCID_MAX_CONCURRENT_JOBS=4
# Optional name of an existing Docker network for API clients.
REELUCID_NETWORK=
